# ==========================================================================
# اختیاری: تنظیمات کش برای هاست‌هایی مثل Netlify یا Cloudflare Pages
# اگه سایتتون رو روی Netlify میزبانی می‌کنید، این فایل رو با اسم "_headers"
# (بدون پسوند) کنار index.html آپلود کنید.
# اگه از هاست Apache/cPanel استفاده می‌کنید، به‌جاش از فایل .htaccess استفاده کنید.
# ==========================================================================

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate
